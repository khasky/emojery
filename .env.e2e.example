# Loaded by the e2e suite as PUBLIC defaults (e2e/lib/load-env.ts) - not just a
# template. Copy to .env.e2e.local for private/local overrides; never put
# secrets here. Shell environment variables override values from this file.

# Backend the specs expect the built extension to target (manifest
# host-permission + reachability check). Staging by default:
#   pnpm run build:staging && pnpm run test:e2e
E2E_API_BASE=https://api-staging.emojery.app

# Extension build the specs load. For a PROD build: `pnpm run build`, then set
# this to .output/chrome-mv3.
E2E_EXTENSION_PATH=.output/chrome-mv3-staging

# "firefox" runs the autonomous suite in Playwright's Firefox instead of
# Chromium: the firefox build is installed as a temporary add-on over the
# remote debugging protocol (e2e/lib/firefox-addon.ts). Build it first:
#   pnpm run build:staging:firefox
# Covers the content-script surfaces (placement, picker, theming, layout).
# Chromium-only specs skip: everything driving the extension's own pages
# (popup/auth - juggler cannot reach moz-extension://), CDP perf, coexistence,
# background-context seeding.
E2E_BROWSER=

# Extension build for E2E_BROWSER=firefox runs (E2E_EXTENSION_PATH stays the
# chrome build). Empty = .output/firefox-mv2-staging.
E2E_FIREFOX_EXTENSION_PATH=

# Build-time API override for a CUSTOM backend - SHELL-ONLY: the build ignores
# this file, and build:staging already targets staging via --mode staging.
WXT_API_BASE=

# Extra dotenv file loaded after the default chain.
E2E_ENV_FILE=

# Private test-account settings for the authed specs. Set both in .env.e2e.local;
# unset => those specs skip. e2e/lib/test-config.ts is where the format is read.
E2E_AUTH_EMAIL=
E2E_AUTH_OTP=

# The address the rejection leg of e2e/auth.spec.ts signs in with. `.invalid` is
# reserved (RFC 2606) and never resolves, so no mail can leave for it; override in
# .env.e2e.local if a run needs a different refused address.
E2E_REJECTED_EMAIL=rejected@example.invalid

# How hard e2e/reaction-burst.spec.ts clicks: per round, how many rounds, and the
# stagger between them in ms. Deliberately empty - set them in .env.e2e.local.
# Unset => that case skips.
E2E_BURST_MAX_CLICKS=
E2E_BURST_ROUNDS=
E2E_BURST_ROUND_MS=

# How many bad codes e2e/accounts.spec.ts sends before it asserts on the error.
# Empty for the same reason as above; unset => that case skips.
E2E_WRONG_CODE_ATTEMPTS=

# "1" enables the site-authenticated bridge suite (e2e/site-auth/, run via
# test:e2e:siteauth): drives your real logged-in Chrome through the Playwright
# Extension. Gated OFF by default; see e2e/site-auth/README.md.
E2E_SITEAUTH=

# Token from the Playwright Extension popup (per browser profile).
PLAYWRIGHT_MCP_EXTENSION_TOKEN=

# Connect to an already-running `@playwright/mcp --extension --port <p>` server.
E2E_MCP_URL=

# Site-auth bridge-suite fixture URLs (logged-in surfaces). These are the
# checked-in defaults; override any of them in .env.e2e / .env.e2e.local. A
# test that needs an unset key FAILS with the key's name - fixtures are
# re-pointed here, never edited into test code.
# E2E_AUTHURL_<SITE> = feed/surface (lifecycle flows), _DETAIL = one stable
# post/permalink (reaction round-trip + persistence-after-reload).
E2E_AUTHURL_FACEBOOK=https://www.facebook.com/
E2E_AUTHURL_FACEBOOK_DETAIL=https://www.facebook.com/zuck/posts/pfbid0NNsMEQqj7ydjUq38s8i2CrNkL6qSwZA3fzvqFbFhrQ223PpicZjdCcNjZhpf83Qol
E2E_AUTHURL_INSTAGRAM=https://www.instagram.com/
E2E_AUTHURL_INSTAGRAM_DETAIL=https://www.instagram.com/p/DVtrMKED9L3/
E2E_AUTHURL_REDDIT=https://www.reddit.com/
E2E_AUTHURL_REDDIT_DETAIL=https://www.reddit.com/r/counterstrike/comments/1tlr8a4/cs_15/
E2E_AUTHURL_THREADS=https://www.threads.com/
E2E_AUTHURL_THREADS_DETAIL=https://www.threads.com/@theromero/post/DYpmDeHjE1L
E2E_AUTHURL_X=https://x.com/home
E2E_AUTHURL_X_DETAIL=https://x.com/romero/status/2056672338423206234
E2E_AUTHURL_YOUTUBE=https://www.youtube.com/watch?v=DRFHklnN-SM
E2E_AUTHURL_YOUTUBE_DETAIL=https://www.youtube.com/watch?v=DRFHklnN-SM
E2E_AUTHURL_GITHUB=https://github.com/torvalds/linux
E2E_AUTHURL_GITHUB_DETAIL=https://github.com/torvalds/linux
E2E_AUTHURL_GITLAB=https://gitlab.com/gitlab-org/gitlab
E2E_AUTHURL_GITLAB_DETAIL=https://gitlab.com/gitlab-org/gitlab
E2E_AUTHURL_AMAZON=https://www.amazon.com/dp/B01LYNW421
E2E_AUTHURL_AMAZON_DETAIL=https://www.amazon.com/dp/B01LYNW421

# Logged-in Facebook GROUP surface (the aggregated feed only has posts when the
# account is in an active group; point this at a specific group instead).
E2E_AUTHURL_FACEBOOK_GROUP=https://www.facebook.com/groups/3558639664446686/

# Facebook permalink whose PINNED TOP COMMENT carries photo attachments - the
# comment-surface regression's exact shape (e2e/site-auth/comment-surface.test.ts).
E2E_AUTHURL_FACEBOOK_PINNED=https://www.facebook.com/zuck/posts/pfbid02hdbQtdRcNbrtHGkiFRLWsC3nmPVfCQjDPv2JKPqw3fBPk5VRvUHCGZSyeWao14BBl

# Facebook group the site-auth warm-up JOINS (if not already a member) so the
# group-feed check has posts, then LEAVES on teardown. Unset = never auto-join;
# the check skips when the account is in no active group.
E2E_WARMUP_FACEBOOK_GROUP=

# Wall-coverage fixtures (e2e/site-auth/wall-coverage.test.ts): a profile wall
# and a SPECIFIC group wall the signed-in account can read (the per-post scroll
# audits), plus one group post permalink (single-picker + click check).
# GROUP_WALL and GROUP_DETAIL are deliberately different groups: a group whose
# FEED renders no Like control for a non-member leaves the wall audit nothing to
# anchor to, while its permalinks still carry one - so the wall uses a group with
# action rows in the feed and the permalink check keeps its own.
E2E_AUTHURL_FACEBOOK_WALL=https://www.facebook.com/zuck
E2E_AUTHURL_FACEBOOK_GROUP_WALL=https://www.facebook.com/groups/3558639664446686/
E2E_AUTHURL_FACEBOOK_GROUP_DETAIL=https://www.facebook.com/groups/1921914684493472/posts/28590901680501410/

# Threads surface for the reply-preview check: a profile's replies tab, where
# every unit is an original post plus that account's reply (the sibling-pressable
# shape the check audits). Separate from E2E_AUTHURL_THREADS, which stays the
# home feed for the deep scroll - the feed carries this shape far too rarely to
# check against. Re-point it if this account goes quiet.
E2E_AUTHURL_THREADS_REPLIES=https://www.threads.com/@mosseri/replies

# Stable multi-image Instagram post for the carousel check (content, not a
# setting) - skipped when unset.
E2E_AUTHURL_INSTAGRAM_CAROUSEL=https://www.instagram.com/p/Da04FxToL6Q/

# Coexistence checks (e2e/coexistence.spec.ts): `;`-separated extension
# sources, each downloaded + unpacked (cached in .playwright/coext-cache) and
# loaded next to Emojery. A source is a GitHub release .zip/.crx URL, a
# Chrome Web Store URL or 32-char id, or a local unpacked folder - MV3 builds
# only. HEAVY: first run downloads ~350 MB and launches one browser per
# extension; set `E2E_COEXT_SOURCES=;` in .env.e2e.local to skip (a BLANK value
# does not - the loader ignores empty values so a placeholder key can't clobber
# a real one, and a lone `;` is the empty list that survives it).
# The value is QUOTED because every direct URL ends in a `#sha256=` pin and
# dotenv reads an unquoted `#` as a comment - unquoted, this line silently
# becomes 1 unpinned source (e2e/coext-source.spec.ts pins that).
# Every direct URL carries a `#sha256=<hex>` CONTENT pin and the run refuses to
# download one without it: a release tag alone can be moved and its asset
# re-uploaded, and these archives are loaded into a browser as unpacked
# extensions. When a version-stamped asset 404s, bump the tag AND recompute the
# digest (`curl -sL "<url>" | sha256sum`) after reviewing the new release. The
# two bare Chrome Web Store ids cannot be pinned at all - they always fetch the
# store's current build, and the run warns about each one.
E2E_COEXT_SOURCES="https://github.com/uBlockOrigin/uBOL-home/releases/download/2026.714.1952/uBOLite_2026.714.1952.chromium.zip#sha256=395033f01ddbfabb23cc1675f17417da83080a028eb9b48e6ebc6dcfbc86d4fb;https://github.com/Anarios/return-youtube-dislike/releases/download/v4.0.4/chrome.zip#sha256=4cf9d401c81cf52b813141a973450ca704fba7478d4105e2bf4a39454a9d9117;https://github.com/ajayyy/SponsorBlock/releases/download/6.1.7/ChromeExtension.zip#sha256=7c8e3dc8b5e560b480ae8efdf28f4f1101fce0cc32434562a336a89e4962eda3;https://github.com/AdguardTeam/AdguardBrowserExtension/releases/download/v5.4.3.1/chrome-mv3.zip#sha256=c91cbb56bbaacc96cb7b9554d9728158ce1791e02895ea5ca5d909cd4764c2f1;https://github.com/darkreader/darkreader/releases/download/v4.9.129/darkreader-chrome-mv3.zip#sha256=20e7993eee8015f7db18748eea366616dfd05ec477efb7be6ae52d2b221b0a64;gighmmpiobklfepjocnamgkkbiglidom;cfhdojbkjhnklbpkdaibdccddilifddb"

# Local-folder-only variant of the above; `;`-separated unpacked dirs.
E2E_COEXT_PATHS=

# Playwright per-test timeout, ms.
E2E_TEST_TIMEOUT_MS=120000

# Playwright expect() timeout, ms.
E2E_EXPECT_TIMEOUT_MS=30000

# "1" records video, retained on failure.
E2E_VIDEO=0

# Branded browser channel (chrome|msedge) instead of bundled Chromium -
# diagnostics only.
E2E_CHROME_CHANNEL=

E2E_BROWSER_EXECUTABLE_PATH=

# "0" disables the realistic-client launch flags (locale/timezone/UA).
E2E_REALISTIC_CLIENT=1

E2E_LOCALE=en-US

# Timezone override; empty = host timezone.
E2E_TIMEZONE_ID=

E2E_USER_AGENT=

# Playwright default action timeout, ms.
E2E_DEFAULT_TIMEOUT_MS=30000

# Playwright default navigation timeout, ms.
E2E_NAV_TIMEOUT_MS=60000

# Keep the browser open N ms after a run to inspect its final state.
E2E_KEEP_OPEN_MS=0

# "1" keeps the generated browser profile after a run instead of deleting it.
E2E_KEEP_PROFILE=0

# Reuse a dedicated warmed profile dir (a warmed profile is served fewer
# interstitials; never point it at your personal profile).
E2E_USER_DATA_DIR=

# Pause between scenarios, ms. 0 = no padding (every step waits on its own
# condition); raise for a watchable headed run when debugging locally.
E2E_STEP_DELAY_MS=0

# Per-site mount deadline, ms.
E2E_SITE_TIMEOUT_MS=70000

# theme-contrast.spec.ts: wait for the pressed trigger styling, ms.
E2E_ACTIVE_STATE_TIMEOUT_MS=45000

# overlay-freeze.spec.ts: mount budget before the freeze scenario, ms.
E2E_OVERLAY_MOUNT_TIMEOUT_MS=25000

# Facebook injection specs: mount budget and post-injection settle, ms. Settle
# stays blank so each spec keeps its own default (comment 8000, group-row 12000).
E2E_FB_INJECT_MOUNT_TIMEOUT_MS=30000
E2E_FB_INJECT_SETTLE_MS=

# site-auth comment-surface: Facebook comment-thread hydration pause, ms.
E2E_FB_COMMENT_HYDRATE_MS=8000

# site-auth wall-coverage: 0.7-viewport scroll steps down the wall.
E2E_WALL_SCROLL_STEPS=8

# Public supported-site test URLs. Override in .env.e2e.local when one goes
# stale. Kept as one block - the names are self-describing.
E2E_URL_X_USER=https://x.com/romero
E2E_URL_X_POST=https://x.com/romero/status/2056672338423206234
E2E_URL_THREADS_USER=https://www.threads.com/@theromero
E2E_URL_THREADS_POST=https://www.threads.com/@theromero/post/DUNuLIhjCb4
E2E_URL_YOUTUBE=https://www.youtube.com/watch?v=dQw4w9WgXcQ
E2E_URL_YOUTUBE_SHORTS=https://www.youtube.com/shorts/4uJxTo6N9cE
E2E_URL_GITHUB=https://github.com/torvalds/linux
E2E_URL_GITLAB=https://gitlab.com/gitlab-org/gitlab
E2E_URL_AMAZON_US=https://www.amazon.com/Microsoft-Project-AZ-EN-XD/dp/B0CXL5KT64/
E2E_URL_AMAZON_CA=https://www.amazon.ca/dp/B0DV9YB8PP/
E2E_URL_FACEBOOK_PAGE=https://www.facebook.com/allo
E2E_URL_FACEBOOK_POST=https://www.facebook.com/zuck/posts/pfbid0NNsMEQqj7ydjUq38s8i2CrNkL6qSwZA3fzvqFbFhrQ223PpicZjdCcNjZhpf83Qol
E2E_URL_FACEBOOK_REEL=https://www.facebook.com/reel/2023034984991863
E2E_URL_INSTAGRAM_POST=https://www.instagram.com/p/DVtrMKED9L3/
E2E_URL_INSTAGRAM_REEL=https://www.instagram.com/reel/CzOsYYsu9jP/
E2E_URL_REDDIT_HOME=https://www.reddit.com/
E2E_URL_REDDIT_POST=https://www.reddit.com/r/counterstrike/comments/1tlr8a4/cs_15/
E2E_URL_REDDIT_USER=https://www.reddit.com/user/shittymorph/
